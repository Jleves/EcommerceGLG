# Plantilla para el gestor de entorno del despliegue; Spring no carga .env automáticamente.
# Sustituir los marcadores mediante el gestor de secretos. No ejecutar con estos valores.
URL_DB=jdbc:mysql://mysql.internal:3306/glg_corralon
USERNAME_DB=glg_corralon
PASSWORD_DB=REEMPLAZAR_DESDE_GESTOR_DE_SECRETOS
DRIVER_DB=com.mysql.cj.jdbc.Driver
JWT_SECRET=REEMPLAZAR_BASE64_ALEATORIO_32_BYTES_O_MAS
MFA_HMAC_SECRET=REEMPLAZAR_OTRA_CLAVE_BASE64_ALEATORIA_32_BYTES_O_MAS
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=3h
PASSWORD_RESET_TOKEN_TTL=30m
COOKIE_SECURE=true
MFA_CHALLENGE_TTL=5m
MFA_MAX_FAILED_ATTEMPTS=5
MFA_RESEND_COOLDOWN=60s
MFA_MAX_RESENDS=3
MFA_AGGREGATE_WINDOW=15m
MFA_MAX_CODE_ISSUES_PER_WINDOW=5
MFA_MAX_CODE_FAILURES_PER_WINDOW=10
MFA_LOGIN_WINDOW=15m
MFA_MAX_LOGIN_ATTEMPTS_PER_ACCOUNT=10
MFA_MAX_LOGIN_ATTEMPTS_PER_IP=30
# IP literales separadas por comas; vacío = confiar solo en la conexión directa.
MFA_TRUSTED_PROXY_ADDRESSES=
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
# También se usa como remitente: debe ser una dirección autorizada por el proveedor.
EMAIL_USERNAME=no-reply@example.com
EMAIL_PASSWORD=REEMPLAZAR_DESDE_GESTOR_DE_SECRETOS
EMAIL_VERIFICATION_BASE_URL=https://app.example.com
FRONTEND_BASE_URL=https://app.example.com
INIT_SUPERADMIN_ENABLED=false
INIT_SUPERADMIN_EMAIL=
INIT_SUPERADMIN_PASSWORD=
